# Configuration du portail SIEM Informix (copier en .env)

# Base d'événements (SQLite)
SIEM_BASE=/donnees/siem.db
# Jeton partagé avec les collecteurs : générer avec  openssl rand -hex 32
SIEM_JETON_COLLECTEUR=A_REMPLACER
# Comptes partagés surveillés (attribution par poste, alertes)
SIEM_COMPTES_PARTAGES=regix,informix,root
# Heures ouvrées (lundi-vendredi)
SIEM_HEURES_OUVREES=08-19
SIEM_ALERTE_HORS_HEURES=oui
SIEM_SEUIL_ECHECS=5
# Conservation des événements (jours)
SIEM_CONSERVATION_JOURS=400

# Assistant IA (questions libres) : auto = actif si une clé API est présente, non = désactivé.
# Les questions proposées fonctionnent toujours, sans IA et sans envoi de données à l'extérieur.
# ATTENTION : en mode IA, les extraits d'événements nécessaires à la réponse sont envoyés à l'API Anthropic.
SIEM_ASSISTANT_IA=non
SIEM_MODELE=claude-opus-5-5
ANTHROPIC_API_KEY=
