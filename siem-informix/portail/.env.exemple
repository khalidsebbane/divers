# =============================================================================================
# Configuration du portail SIEM (copier en .env, ou /etc/siem-portail/portail.env en installation native)
# Fichier à protéger : chmod 600 (contient le mot de passe du compte de service AD)
# =============================================================================================

# --- Données
SIEM_BASE=/donnees/siem.db
SIEM_CONSERVATION_JOURS=400

# --- Marque du client
SIEM_MARQUE_NOM=SIEM Informix
SIEM_MARQUE_SOUS_TITRE=Traçabilité système, base et applicatif
SIEM_MARQUE_COULEUR=#1c5cab
SIEM_MARQUE_LOGO=/marque/logo.png

# --- Active Directory (laisser SIEM_AD_SERVEURS vide = comptes locaux uniquement)
# Plusieurs contrôleurs séparés par des virgules (bascule automatique). LDAPS recommandé (port 636).
SIEM_AD_SERVEURS=ldaps://dc1.domaine.local:636,ldaps://dc2.domaine.local:636
SIEM_AD_BASE_DN=DC=domaine,DC=local
SIEM_AD_DOMAINE=DOMAINE
# Compte de service en lecture seule (aucun droit particulier, mot de passe qui n'expire pas)
SIEM_AD_COMPTE_SERVICE=CN=svc-siem,OU=Comptes de service,DC=domaine,DC=local
SIEM_AD_MDP_SERVICE=A_REMPLACER
# Groupes AD donnant accès au portail (groupes imbriqués acceptés)
SIEM_AD_GROUPE_ADMIN=CN=GG_SIEM_Administrateurs,OU=Groupes,DC=domaine,DC=local
SIEM_AD_GROUPE_LECTEUR=CN=GG_SIEM_Lecteurs,OU=Groupes,DC=domaine,DC=local
# Certificat de l'autorité de certification interne (format PEM) pour vérifier les contrôleurs
SIEM_AD_CA=/certs/ca-interne.pem
SIEM_AD_VERIFIER_CERTIFICAT=oui

# --- Sessions et sécurité
SIEM_SESSION_HEURES=8
SIEM_SESSION_INACTIVITE_MIN=30
SIEM_MAX_ECHECS_CONNEXION=5
SIEM_BLOCAGE_MIN=15
SIEM_COOKIE_SECURISE=oui

# --- Collecte
SIEM_PLANIFICATEUR=oui
# Réception poussée depuis des collecteurs autonomes (facultatif ; vide = désactivée)
SIEM_JETON_COLLECTEUR=

# --- Notifications e-mail des alertes hautes et critiques (facultatif)
SIEM_SMTP_SERVEUR=
SIEM_SMTP_PORT=587
SIEM_SMTP_STARTTLS=oui
SIEM_SMTP_UTILISATEUR=
SIEM_SMTP_MDP=
SIEM_SMTP_EXPEDITEUR=siem@domaine.local
SIEM_SMTP_DESTINATAIRES=securite@domaine.local
SIEM_NOTIF_GRAVITES=haute,critique
SIEM_URL_PORTAIL=https://siem.domaine.local

# --- Règles d'alerte
SIEM_COMPTES_PARTAGES=regix,informix,root
SIEM_HEURES_OUVREES=08-19
SIEM_ALERTE_HORS_HEURES=oui
SIEM_SEUIL_ECHECS=5

# --- Assistant IA (questions libres). Les questions proposées fonctionnent toujours, sans IA.
# ATTENTION : en mode IA, les extraits d'événements utiles à la réponse sont envoyés à l'API Anthropic.
# Sur un serveur isolé sans accès Internet, laisser « non ».
SIEM_ASSISTANT_IA=non
SIEM_MODELE=claude-opus-5-5
ANTHROPIC_API_KEY=
